# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets -- never commit. Use .env.example as the committed template.
.env
.env.*
!.env.example

# Virtual environment
.venv/

# Dead Python 3.11 venv that was committed at the repo root (its interpreter no
# longer exists on this machine; .venv/ replaces it)
bin/
include/
lib/
lib64
share/
pyvenv.cfg

# Model checkpoints -- hundreds of MB each, regenerated by training
*.pt
!.gitkeep

# Trained tokenizer artifacts and their training corpus
**/training_data.txt

# Collected datasets
data/*.parquet

# Generated output
checkpoints/
outputs/
