# Copy to .env and fill in real values. .env is gitignored and must never be committed.
#
#     cp .env.example .env
#
# Exported environment variables take precedence over anything set here.

# --- Reddit API (data_collection.py --dataset reddit, train_demo.py) ---
# Create an app at https://www.reddit.com/prefs/apps to obtain these.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:llm-training-data:v1.0
# Only needed for the archived OAuth helper (archive/redditText.py)
REDDIT_REDIRECT_URI=http://localhost:8080

# --- Hugging Face (testHFToken.py, private model downloads) ---
# Token from https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=
